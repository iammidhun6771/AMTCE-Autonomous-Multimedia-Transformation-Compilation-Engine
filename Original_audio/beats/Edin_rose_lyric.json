  "lyrics": [
    {
      "time": 1.03,
      "end": 2.94,
      "text": "Khadi saamne woh lagti khalifa",
      "emotion_weight": 0.7,
      "emotion_tag": "hype",
      "section": "verse"
    },
    {
      "time": 3.35,
      "end": 5.64,
      "text": "Goa chalti toh lagta hai pizza",
      "emotion_weight": 0.6,
      "emotion_tag": "playful",
      "section": "verse"
    },
    {
      "time": 6.13,
      "end": 7.96,
      "text": "Dil peega jab dekhti woh sheesha",
      "emotion_weight": 0.7,
      "emotion_tag": "intimacy",
      "section": "pre_chorus"
    },
    {
      "time": 8.31,
      "end": 10.44,
      "text": "Papa raazi nahi photo toh kheech na",
      "emotion_weight": 0.8,
      "emotion_tag": "playful",
      "section": "pre_chorus"
    },
    {
      "time": 10.66,
      "end": 12.63,
      "text": "Photo kheech woh lagti bonita",
      "emotion_weight": 0.9,
      "emotion_tag": "love",
      "section": "chorus"
    },
    {
      "time": 13.06,
      "end": 14.93,
      "text": "Photo kheech woh lagti thi peeka",
      "emotion_weight": 0.85,
      "emotion_tag": "love",
      "section": "chorus"
    },
    {
      "time": 15.0,
      "end": 17.18,
      "text": "Woh jab chalti toh lagti hai cheeta",
      "emotion_weight": 0.9,
      "emotion_tag": "power",
      "section": "chorus"
    },
    {
      "time": 17.48,
      "end": 19.92,
      "text": "Woh jab saamne khada sab lage pheeka",
      "emotion_weight": 0.88,
      "emotion_tag": "euphoria",
      "section": "chorus"
    },
    {
      "time": 20.0,
      "end": 22.37,
      "text": "Mere sapno ki rani kab aayegi",
      "emotion_weight": 0.7,
      "emotion_tag": "nostalgia",
      "section": "verse"
    },
    {
      "time": 22.56,
      "end": 24.46,
      "text": "Doctor Divineon mein rakhta dawai bhi",
      "emotion_weight": 0.65,
      "emotion_tag": "confident",
      "section": "verse"
    },
    {
      "time": 24.81,
      "end": 27.18,
      "text": "Tu aur teri dost mere saath mere bhai bhi",
      "emotion_weight": 0.7,
      "emotion_tag": "celebration",
      "section": "verse"
    },
    {
      "time": 27.6,
      "end": 28.48,
      "text": "Bole kitna sata...",
      "emotion_weight": 0.6,
      "emotion_tag": "neutral",
      "section": "outro"
    }
  ],
