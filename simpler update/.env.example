# ==============================================================================
# PROJECT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your real API keys & tokens.
# ==============================================================================

# ── 1. AI Perception & LLM Keys ───────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── 2. Ingestion & Scraper Keys ───────────────────────────────────────────────
APIFY_API_TOKEN=your_apify_token_here
APIFY_REELS_PER_ACCOUNT=3
APIFY_DAILY_QUOTA=200
APIFY_MIN_VIEW_COUNT=500
APIFY_DEEP_LIMIT=0
APIFY_SCRAPE_FROM_DATE=

# ── 3. Telegram Vault & Notifications ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_STORAGE_GROUP_ID=your_telegram_group_id_here

# ── 4. Social Media Uploaders ──────────────────────────────────────────────────
# Meta (Instagram & Facebook Reels)
META_PAGE_ID=your_meta_page_id_here
META_PAGE_TOKEN=your_meta_page_token_here
IG_BUSINESS_ID=your_ig_business_id_here
IG_BUSINESS_TOKEN=your_ig_business_token_here

# TikTok
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here



# ── 6. Publishing & Scheduler Controls ───────────────────────────────────────
CLIPS_PER_BATCH=1
PUBLISH_STATIC_TIMES=07:30,12:30,19:30
PUBLISH_ACTIVE_HOURS_START=07:00
PUBLISH_ACTIVE_HOURS_END=23:00
FORCE_NEXT_BATCH=no
